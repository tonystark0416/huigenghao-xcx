<view class="orders-page">

  <!-- 平台Tab：唯品会 / 美团 -->
  <view class="platform-tabs">
    <view
      wx:for="{{platformTabs}}"
      wx:key="key"
      class="tab-item {{platform === item.key ? 'tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onPlatformChange"
    >
      <text
        class="tab-text"
        style="{{platform === item.key ? 'color:' + item.color + ';font-weight:600;' : ''}}"
      >{{item.name}}</text>
      <view
        wx:if="{{platform === item.key}}"
        class="tab-line"
        style="background:{{item.color}};"
      ></view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-container" wx:elif="{{empty}}">
    <view class="empty-icon">📦</view>
    <text class="empty-text">暂无{{platformName}}订单</text>
    <view class="retry-btn" bindtap="onRetryTap">刷新</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:else>
    <view
      class="order-card"
      wx:for="{{orderList}}"
      wx:key="id"
    >
      <!-- 卡片头：订单号 + 状态 -->
      <view class="order-card-header">
        <text class="order-sn">订单号 {{item.orderSn}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>

      <!-- 卡片体：商品图 + 信息 -->
      <view class="order-card-body">
        <image
          class="order-goods-img"
          src="{{item.goodsImgUrl}}"
          mode="aspectFill"
          lazy-load="{{true}}"
        />
        <view class="order-info">
          <text class="order-goods-name">{{item.goodsName}}</text>
          <text class="order-platform">{{item.platformText}}</text>
          <text class="order-time">下单时间 {{item.createTimeText}}</text>
        </view>
      </view>

      <!-- 卡片尾：实付金额 -->
      <view class="order-card-footer">
        <view class="order-amount">
          <text class="order-amount-label">实付</text>
          <text class="order-amount-value">¥{{item.orderAmount}}</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadMoreLoading}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:elif="{{!hasMore && orderList.length > 0}}">
      <text>没有更多了</text>
    </view>
  </view>

  <!-- 手机号登录弹窗 -->
  <view class="login-modal" wx:if="{{showLoginModal}}" catchtouchmove="noop">
    <view class="login-mask" bindtap="closeLoginModal"></view>
    <view class="login-dialog">
      <view class="login-title">欢迎使用值物APP</view>
      <view class="login-desc">登录后即可查看我的订单</view>
      <button class="login-phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
        手机号快捷登录
      </button>
      <view class="login-skip" bindtap="closeLoginModal">暂不登录</view>
    </view>
  </view>

</view>
