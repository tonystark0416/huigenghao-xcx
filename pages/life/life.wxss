.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading,
.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}

.banner-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.banner-card-hover {
  opacity: 0.9;
}

.banner-img {
  width: 100%;
  display: block;
}

.banner-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.banner-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.banner-sub {
  flex: 2;
  font-size: 24rpx;
  color: #999999;
  margin-left: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #cccccc;
  margin-left: 16rpx;
}
