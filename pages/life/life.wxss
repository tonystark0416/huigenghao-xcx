.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading,
.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}

/* ==================== 搜索栏 ==================== */

.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 3rpx solid #81d8cf;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 4rpx 16rpx rgba(129, 216, 207, 0.4);
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #0ea294;
  border-radius: 50%;
  position: relative;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  width: 3rpx;
  height: 14rpx;
  background: #0ea294;
  border-radius: 2rpx;
  transform: rotate(-45deg);
  right: -8rpx;
  bottom: -6rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #bbbbbb;
}

.search-clear {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #0ea294;
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
  margin-left: 12rpx;
}

.search-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #ffffff;
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
  border: 3rpx solid #111111;
  box-sizing: border-box;
  border-radius: 40rpx;
}

.search-loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}

/* ==================== 排序栏 ==================== */

.sort-bar {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sort-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  padding: 14rpx 0;
  border-radius: 10rpx;
  transition: all 0.2s;
}

.sort-item-active {
  color: #0ea294;
  font-weight: bold;
  background: #e5f7f3;
}

/* ==================== Banner ==================== */

.banner-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.banner-card-hover {
  opacity: 0.9;
}

.banner-img {
  width: 100%;
  display: block;
}

.banner-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.banner-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.banner-sub {
  flex: 2;
  font-size: 24rpx;
  color: #999999;
  margin-left: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #cccccc;
  margin-left: 16rpx;
}

/* ==================== 商品列表 ==================== */

.goods-card {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.goods-card-hover {
  opacity: 0.85;
}

.goods-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.goods-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title-wrap {
  display: flex;
  align-items: flex-start;
}

.goods-brand {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #0ea294;
  border: 2rpx solid #0ea294;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
}

.goods-title {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.goods-poi {
  flex: 1;
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sales {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #999999;
  margin-left: 12rpx;
}

.goods-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.goods-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #0ea294;
}

.goods-original {
  font-size: 24rpx;
  color: #bbbbbb;
  text-decoration: line-through;
  margin-left: 12rpx;
}

.goods-rebate {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #0ea294;
  background: rgba(129, 216, 207, 0.18);
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  margin-left: auto;
}

.goods-footer {
  padding: 24rpx 0 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #bbbbbb;
}

/* ==================== 手机号登录弹窗 ==================== */

.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.login-dialog {
  position: relative;
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.login-phone-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ffffff;
  color: #111111;
  font-size: 30rpx;
  font-weight: bold;
  border: 3rpx solid #111111;
  box-sizing: border-box;
  border-radius: 44rpx;
  padding: 0;
}

.login-phone-btn::after {
  border: none;
}

.login-skip {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #bbb;
  padding: 8rpx 16rpx;
}
