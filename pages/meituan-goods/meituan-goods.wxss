/**pages/meituan-goods/meituan-goods.wxss**/

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 悬浮返回按钮 */
.nav-back-btn {
  position: fixed;
  left: 16px;
  z-index: 999;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  /* 半透明白底，可透出底部图片 */
  background: rgba(255, 255, 255, 0.45);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-btn-hover {
  background: rgba(255, 255, 255, 0.7);
}

.nav-back-icon {
  width: 18px;
  height: 18px;
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='24'%20height='24'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M15%204.5%20L7.5%2012%20L15%2019.5'%20stroke='%23333333'%20stroke-width='2.6'%20fill='none'%20stroke-linecap='round'%20stroke-linejoin='round'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* 加载态 */
.loading-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 滚动区 */
.detail-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

/* 商品主图 */
.goods-image {
  width: 100%;
  height: 750rpx;
  display: block;
  background: #f8f8f8;
}

/* 价格区域（浅橙渐变底，突出券后价） */
.price-section {
  background: linear-gradient(135deg, #fff4ec 0%, #ffffff 70%);
  padding: 28rpx 24rpx;
  margin-bottom: 12rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: #ff5000;
  font-weight: 600;
}

.price-value {
  font-size: 48rpx;
  color: #ff5000;
  font-weight: 700;
  line-height: 1;
  margin-right: 12rpx;
}

.original-price {
  font-size: 24rpx;
  color: #bbb;
  text-decoration: line-through;
  margin-right: 12rpx;
}

/* 价格力标签（如“15天低价”） */
.price-label {
  font-size: 20rpx;
  color: #ff5000;
  background: rgba(255, 77, 0, 0.1);
  border-radius: 6rpx;
  display: inline-flex;
  align-items: center;
  line-height: 1;
  height: 36rpx;
  padding: 0 12rpx;
}

/* 返利行 */
.rebate-row {
  display: flex;
  align-items: baseline;
}

.rebate-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.rebate-value {
  font-size: 32rpx;
  color: #ff5000;
  font-weight: 700;
}

/* 商品信息 */
.info-section {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 12rpx;
}

.goods-title {
  font-size: 30rpx;
  color: #333;
  line-height: 44rpx;
}

.goods-sales {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 门店信息 */
.store-card {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.store-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #f8f8f8;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.store-text {
  flex: 1;
  min-width: 0;
}

.store-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.store-meta {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
}

.store-meta-item {
  font-size: 24rpx;
  color: #999;
  margin-right: 24rpx;
}

/* 购买须知 */
.meta-section {
  background: #fff;
  padding: 0 24rpx 12rpx;
}

.meta-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 0 4rpx;
}

.meta-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.meta-item:last-child {
  border-bottom: none;
}

.meta-label {
  font-size: 26rpx;
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}

.meta-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  line-height: 38rpx;
}

/* 底部操作栏 */
.bottom-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.buy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff4d00, #ff9402);
  border: none;
  box-sizing: border-box;
  border-radius: 42rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 77, 0, 0.25);
  padding: 0;
}

.buy-btn::after {
  border: none;
}

/* 手机号登录弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.login-dialog {
  position: relative;
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: dialogPopIn 0.25s ease-out;
}

@keyframes dialogPopIn {
  from { opacity: 0; transform: scale(0.92); }
  to   { opacity: 1; transform: scale(1); }
}

.login-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.login-phone-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #ff4d00, #ff9402);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  box-sizing: border-box;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 77, 0, 0.25);
  padding: 0;
}

.login-phone-btn::after {
  border: none;
}

.login-skip {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #bbb;
  padding: 8rpx 16rpx;
}
