/**index.wxss**/

page {
  background: #f5f5f5;
}

/* 顶部搜索栏（固定在视口顶部，顶部间距由 JS 按状态栏高度填充，右侧为胶囊按钮让位收窄） */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 0 10rpx 32rpx;
  box-sizing: border-box;
  background: #81d8cf;
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 64rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 3rpx solid #81d8cf;
  border-radius: 40rpx;
  padding: 0 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(129, 216, 207, 0.45);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.search-placeholder {
  font-size: 28rpx;
  color: #bbb;
}

/* 粘贴购物链接 */
.link-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.link-input-wrap {
  display: flex;
  flex-direction: column;
  height: 240rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 20rpx 20rpx 16rpx;
  margin-bottom: 20rpx;
}

.link-textarea {
  flex: 1;
  width: 100%;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.link-placeholder {
  color: #bbb;
  font-size: 26rpx;
}

.link-paste-btn {
  align-self: flex-end;
  padding: 0 28rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  color: #0ea294;
  background: #fff;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.link-find-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #111;
  background: #fff;
  border: 3rpx solid #111;
  box-sizing: border-box;
  border-radius: 40rpx;
}

.btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* ==================== 链接转换结果卡片 ==================== */
.link-result-card {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  animation: resultSlideIn 0.3s ease-out;
}

@keyframes resultSlideIn {
  from { opacity: 0; transform: translateY(-16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-label-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.result-close {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ccc;
}

.result-body {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.result-section {
  display: flex;
  flex-direction: column;
}

.result-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.result-url-text {
  font-size: 26rpx;
  color: #666;
  word-break: break-all;
  line-height: 1.6;
}

.result-url-highlight {
  color: #0ea294;
  font-weight: 500;
}

.result-divider {
  height: 1rpx;
  background: #e8e8e8;
  margin: 16rpx 0;
}

.result-copy-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #111;
  background: #fff;
  border: 3rpx solid #111;
  box-sizing: border-box;
  border-radius: 40rpx;
  padding: 0;
}

.result-copy-btn::after {
  border: none;
}

.result-link-copy-btn {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #111;
  background: #fff;
  border: 3rpx solid #111;
  box-sizing: border-box;
  border-radius: 12rpx;
  padding: 0;
  margin-top: 16rpx;
}

.result-link-copy-btn::after {
  border: none;
}

/* 电商平台入口 */
.platform-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 20rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.platform-grid {
  display: flex;
  justify-content: space-around;
}

.platform-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.platform-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.platform-icon-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1;
}

.platform-name {
  font-size: 24rpx;
  color: #666;
}

/* 瀑布流商品列表 */
.goods-section {
  padding: 28rpx 24rpx 60rpx 24rpx;
}

.waterfall-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.goods-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.goods-image {
  width: 100%;
  display: block;
}

.goods-info {
  padding: 16rpx 20rpx 20rpx;
}

.goods-title {
  font-size: 26rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.goods-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 6rpx;
}

.goods-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #0ea294;
}

.goods-original-price {
  font-size: 22rpx;
  color: #bbb;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.goods-rebate {
  font-size: 22rpx;
  color: #0ea294;
  background: rgba(129, 216, 207, 0.18);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.goods-status {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #bbb;
}

.goods-loading {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #bbb;
}

.goods-end {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #ccc;
}

/* 手机号登录弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.login-dialog {
  position: relative;
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.login-phone-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #111;
  font-size: 30rpx;
  font-weight: bold;
  border: 3rpx solid #111;
  box-sizing: border-box;
  border-radius: 44rpx;
  padding: 0;
}

.login-phone-btn::after {
  border: none;
}

.login-skip {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #bbb;
  padding: 8rpx 16rpx;
}
