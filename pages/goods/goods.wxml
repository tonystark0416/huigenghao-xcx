<!--pages/goods/goods.wxml-->
<view class="page">
  <!-- 悬浮返回按钮（顶部导航已去除，图片置顶；top 与胶囊对齐） -->
  <view class="nav-back-btn" style="{{navBackStyle}}" hover-class="nav-back-btn-hover" bindtap="onNavBack">
    <view class="nav-back-icon"></view>
  </view>

  <block wx:if="{{loading}}">
    <view class="loading-container">
      <text class="loading-text">加载中...</text>
    </view>
  </block>

  <block wx:elif="{{goods}}">
    <scroll-view class="detail-scroll" scroll-y>
      <!-- 商品主图轮播 -->
      <swiper class="goods-swiper" wx:if="{{goods.images.length > 0}}"
        indicator-dots="{{goods.images.length > 1}}"
        indicator-color="rgba(255, 255, 255, 0.4)"
        indicator-active-color="#ffffff"
        circular="{{goods.images.length > 1}}"
        autoplay="{{goods.images.length > 1}}"
        interval="4000">
        <swiper-item wx:for="{{goods.images}}" wx:key="*this">
          <image class="goods-image" src="{{item}}" mode="aspectFill"
            data-url="{{item}}" bindtap="previewMainImage"></image>
        </swiper-item>
      </swiper>
      <image wx:else class="goods-image" src="{{goods.image}}" mode="aspectFill"
        data-url="{{goods.image}}" bindtap="previewMainImage"></image>

      <!-- 价格区域 -->
      <view class="price-section">
        <view class="price-row">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{goods.price}}</text>
          <text wx:if="{{goods.originalPrice > goods.price}}" class="original-price">¥{{goods.originalPrice}}</text>
        </view>

        <!-- 价格计算方式 -->
        <view wx:if="{{goods.priceDescParts && goods.priceDescParts.length > 0}}" class="price-desc-row">
          <view class="price-desc-inner">
            <block wx:for="{{goods.priceDescParts}}" wx:for-item="part" wx:key="id">
              <text wx:if="{{index > 0}}" class="price-desc-minus">-</text>
              <text class="price-desc-part {{part.highlight ? 'price-desc-part-hl' : ''}}">{{part.text}}</text>
            </block>
          </view>
        </view>

        <!-- 返利信息（暂隐藏） -->
        <view wx:if="{{false}}" class="rebate-row">
          <text class="rebate-label">预估返利</text>
          <text class="rebate-value">¥{{goods.rebate}}</text>
          <text wx:if="{{goods.rebateRate}}" class="rebate-rate">(返{{goods.rebateRate}}%)</text>
        </view>
      </view>

      <!-- 商品标题 -->
      <view class="info-section">
        <text class="goods-title">{{goods.title}}</text>
      </view>

      <!-- 标签 -->
      <view wx:if="{{goods.tags.length > 0}}" class="tags-row">
        <text wx:for="{{goods.tags}}" wx:key="*this" class="tag-item">{{item}}</text>
      </view>

      <!-- 店铺 & 分类 -->
      <view class="meta-section">
        <view wx:if="{{goods.brandName}}" class="meta-item">
          <text class="meta-label">品牌</text>
          <text class="meta-value">{{goods.brandName}}</text>
        </view>
        <view wx:if="{{goods.storeName}}" class="meta-item">
          <text class="meta-label">店铺</text>
          <text class="meta-value">{{goods.storeName}}</text>
        </view>
        <view wx:if="{{goods.categoryName}}" class="meta-item">
          <text class="meta-label">分类</text>
          <text class="meta-value">{{goods.categoryName}}</text>
        </view>
        <view wx:if="{{goods.sales}}" class="meta-item">
          <text class="meta-label">销量</text>
          <text class="meta-value">{{goods.sales}}</text>
        </view>
      </view>

      <!-- 详情图片（detailImages 拼接） -->
      <view wx:if="{{goods.detailImages.length > 0}}" class="detail-images">
        <image wx:for="{{goods.detailImages}}" wx:key="*this" class="detail-img"
          src="{{item}}" mode="widthFix" lazy-load="{{true}}"
          data-url="{{item}}" bindtap="previewDetailImage"></image>
      </view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <!-- 底部返利（暂隐藏） -->
      <view wx:if="{{false}}" class="bottom-rebate">
        <text class="bottom-rebate-label">返利</text>
        <text class="bottom-rebate-value">¥{{goods.rebate}}</text>
      </view>
      <button class="buy-btn" bindtap="onBuyTap">前往购买</button>
    </view>
  </block>

  <block wx:else>
    <view class="loading-container">
      <text class="loading-text">商品信息获取失败</text>
    </view>
  </block>

  <!-- 手机号登录弹窗（前往购买需登录获取 uid） -->
  <view class="login-modal" wx:if="{{showLoginModal}}" catchtouchmove="noop">
    <view class="login-mask" bindtap="closeLoginModal"></view>
    <view class="login-dialog">
      <view class="login-title">欢迎使用惠更好</view>
      <view class="login-desc">购买前需要登录，请授权手机号</view>
      <button class="login-phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
        手机号快捷登录
      </button>
      <view class="login-skip" bindtap="closeLoginModal">暂不登录</view>
    </view>
  </view>
</view>
